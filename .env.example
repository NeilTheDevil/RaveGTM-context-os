# Copy to .env and fill in. .env is gitignored. Never paste keys into chat or commit them.

# Localpipe (Google Maps lead data). Account dashboard -> API keys.
LOCALPIPE_API_KEY=
# Localpipe's public anon key, published in their API docs (role: anon). Not a secret, kept out of code anyway.
LOCALPIPE_ANON_KEY=

# PlusVibe sequencer (API, not MCP: bulk lead loads would bloat context)
PLUSVIBE_API_KEY=
PLUSVIBE_WORKSPACE_ID=

# treg.to is logged in through its CLI (`treg login`), scoped to this project in .treg/ (gitignored)
