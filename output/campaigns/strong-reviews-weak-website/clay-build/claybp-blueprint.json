          "formulaText": "Math.max.apply(null, ((String({{@Scrape Homepage}}?.bodyText || \"\").match(/(\u00a9|copyright).{0,80}/i) || [\"\"])[0].match(/(?:19|20)[0-9]{2}/g) || [\"0\"]).map(Number)) || \"\""
