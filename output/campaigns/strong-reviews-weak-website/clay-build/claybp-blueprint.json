        "name": "Cell",
        "type": "formula",
        "typeSettings": {
          "dataTypeSettings": {
            "type": "text"
          },
          "formulaType": "text",
          "formulaText": "!{{@Strong Reviews?}} ? \"Out: reviews not strong\" : !{{@Scrape Homepage}} && !{{@Scrape HTTP Fallback}} ? \"Out: site down\" : {{@Business Type}} !== \"independent_tree_service\" ? \"Out: not an independent tree service\" : {{@Not Secure?}} ? \"C1 Not secure\" : ({{@Footer Year}} && Number({{@Footer Year}}) <= 2022) ? \"C2 Old footer\" : {{@Biggest Site Gap}} === \"reviews_not_shown\" ? \"C4 Reviews not shown\" : {{@Biggest Site Gap}} === \"no_click_to_call\" ? \"C5 No click-to-call\" : {{@Biggest Site Gap}} === \"no_quote_request\" ? \"C6 No quote request\" : \"Held: no gap found (C3 slow on phones needs a PageSpeed key)\""
        }
