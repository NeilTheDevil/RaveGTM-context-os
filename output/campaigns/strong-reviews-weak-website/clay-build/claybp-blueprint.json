            {
              "name": "model",
              "formulaText": "\"gemini-3-flash\""
            },
            {
              "name": "prompt",
              "formulaText": "\"You review the homepage of a local tree service for three things that turn a Google search into a phone call. Use only the data below. Answer with JSON only, no code fences.\\nCompany: \" + ({{@Company Name}} || \"\") + \"\\nGoogle rating: \" + String({{@Google Rating}} || \"\") + \" from \" + String({{@Google Review Count}} || \"\") + \" reviews\" + \"\\nClick-to-call (tel:) links on the page: \" + String({{@Click-to-Call Links}}) + \"\\nPage mentions a quote or estimate: \" + String({{@Mentions Quote?}}) + \"\\nHomepage text (start): \" + String({{@Scrape Homepage}}?.bodyText || \"\").slice(0, 3000) + \"\\n\\nReturn exactly: {\\\"reviews_shown\\\": one of [\\\"yes\\\", \\\"no\\\", \\\"unclear\\\"], \\\"click_to_call\\\": one of [\\\"yes\\\", \\\"no\\\", \\\"unclear\\\"], \\\"quote_request\\\": one of [\\\"yes\\\", \\\"no\\\", \\\"unclear\\\"], \\\"biggest_gap\\\": one of [\\\"reviews_not_shown\\\", \\\"no_click_to_call\\\", \\\"no_quote_request\\\", \\\"none\\\", \\\"unclear\\\"], \\\"evidence\\\": one short fact from the data above that shows the gap, or \\\"none\\\"}. reviews_shown = yes only if the page shows customer reviews, star ratings or testimonials. click_to_call = yes if there is at least one tel: link. quote_request = yes if visitors can ask for a quote or estimate. biggest_gap = reviews_not_shown when the Google rating is strong but the page shows no reviews; otherwise the first missing item in this order: click_to_call, quote_request; none if all three are present.\""
            }
          ],
          "conditionalRunFormulaText": "{{@Business Type}} === \"independent_tree_service\" && !!{{@Scrape Homepage}}",
          "customRateLimitRules": {
