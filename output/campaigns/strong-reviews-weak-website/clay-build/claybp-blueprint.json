            },
            {
              "name": "model",
              "formulaText": "\"gemini-3-flash\""
            },
            {
              "name": "prompt",
              "formulaText": "\"You check whether a company is an independent, owner-run tree service business in the United States. Use only the data below. Answer with JSON only, no code fences.\\nCompany name: \" + ({{@Company Name}} || \"\") + \"\\nWebsite: \" + ({{@Domain}} || \"\") + \"\\nLinkedIn description: \" + String({{@Description}} || \"\").slice(0, 800) + \"\\nHomepage title: \" + ({{@Scrape Homepage}}?.title || \"\") + \"\\nHomepage text (start): \" + String({{@Scrape Homepage}}?.bodyText || \"\").slice(0, 2500) + \"\\n\\nReturn exactly: {\\\"business_type\\\": one of [\\\"independent_tree_service\\\", \\\"franchise_or_chain\\\", \\\"not_tree_service\\\", \\\"unclear\\\"], \\\"offers_tree_work\\\": one of [\\\"yes\\\", \\\"no\\\", \\\"unclear\\\"], \\\"evidence\\\": a short quote or fact from the data above that supports the answer}. independent_tree_service = a local company that does tree removal, trimming or arborist work itself and is not part of a national franchise. If tree work is only a minor add-on to landscaping or lawn care, use not_tree_service. If the data is too thin, use unclear.\""
            }
          ],
          "conditionalRunFormulaText": "{{@Strong Reviews?}} && !!{{@Scrape Homepage}}",
          "customRateLimitRules": {
            "timeWindow": [
              {
                "limit": 17,
                "bucket": [
                  "PRIVATE_AUTH_KEY",
                  "CUSTOM_KEY"
                ],
                "durationMs": 1000
              },
              {
